<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_simulation</name>
  <version>0.1.0</version>
  <description>
    Gazebo Harmonic simulation of the UGV: an office world, the robot model with
    differential drive, lidar and IMU, and the ROS-Gazebo bridge. Runs the UGV
    stack (ugv_bringup with backend:=sim) on simulated time.
  </description>
  <maintainer email="support@t3gemstone.org">T3 Gemstone</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ugv_bringup</exec_depend>
  <exec_depend>ugv_description</exec_depend>
  <exec_depend>ugv_interfaces</exec_depend>
  <exec_depend>ugv_line</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>xacro</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-yaml</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
