    <!-- Line following track: black tape 2 cm wide, two 1.6 m straights
         (y = 0.0 and -1.2) and two 0.6 m radius turns around (-0.8, -0.6) and (-2.4, -0.6).
         Visual only (no collision), so the robot drives over it. The robot starts on the
         north straight at (-1.6, 0) facing +x; the loop runs clockwise from there. -->
    <model name="line_track">
      <static>true</static>
      <link name="tape">
        <visual name="tape_00">
          <pose>-1.6000 0.0000 0.0005 0 0 0.0000</pose>
          <geometry><box><size>1.6040 0.02 0.001</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
        <visual name="tape_01">
          <pose>-1.6000 -1.2000 0.0005 0 0 0.0000</pose>
          <geometry><box><size>1.6040 0.02 0.001</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
        <visual name="tape_02">
          <pose>-0.7739 -0.0011 0.0005 0 0 -0.0436</pose>
          <geometry><box><size>0.0553 0.02 0.001</size></box></geometry>
          <material>
            <ambient>0.05 0.05 0.05 1</ambient>
            <diffuse>0.05 0.05 0.05 1</diffuse>
            <specular>0 0 0 1</specular>
          </material>
        </visual>
        <visual name="tape_03">
          <pose>-0.7218 -0.0057 0.0005 0 0 -0.1309</pose>
          <geometry><box><size>0.0553 0.02 0.001</size></box></geometry>
