<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_imu</name>
  <version>0.1.0</version>
  <description>
    Driver for the T3 Gemstone O1's onboard ICM-20948 IMU (SPI). Calibrates the gyro bias
    at startup and publishes imu/data_raw. icm20948.c/.h: T3 Foundation, Apache-2.0.
  </description>
  <maintainer email="support@t3gemstone.org">T3 Gemstone</maintainer>
  <license>Apache-2.0</license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <depend>rclcpp</depend>
  <depend>sensor_msgs</depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
