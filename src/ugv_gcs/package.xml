<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_gcs</name>
  <version>0.1.0</version>
  <description>
    Browser UI for manual driving, mode selection, emergency stop, map viewing/saving
    and goal setting. Runs rosbridge + a static web server on the robot.
  </description>
  <maintainer email="support@t3gemstone.org">T3 Gemstone</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ugv_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>tf2_ros_py</exec_depend>
  <exec_depend>rosbridge_server</exec_depend>

  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
