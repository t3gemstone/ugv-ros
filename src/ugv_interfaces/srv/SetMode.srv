# Changes the robot's drive mode (ugv_control/mode_manager_node).

string IDLE=idle      # motors stop, no source can write to /cmd_vel
string MANUAL=manual  # teleop from the host (/cmd_vel/teleop)
string LINE=line      # line following (/cmd_vel/line)
string NAV=nav        # Nav2 go-to-goal (/cmd_vel/nav)

string mode
---
bool success
string message
