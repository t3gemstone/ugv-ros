<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>ugv_line</name>
  <version>0.1.0</version>
  <description>Driver for a Deneyap Kart (analog, UART), QTR-RC or digital IR line sensor array, and PD-based line following.</description>
  <maintainer email="support@t3gemstone.org">T3 Gemstone</maintainer>
  <license>Apache-2.0</license>

  <exec_depend>ugv_hal</exec_depend>
  <exec_depend>ugv_interfaces</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <exec_depend>python3-yaml</exec_depend>

  <test_depend>python3-pytest</test_depend>
  <test_depend>python3-serial</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
